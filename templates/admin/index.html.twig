{% extends 'base.html.twig' %}

{% block title %}Administration - Stubborn{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <h1 class="mb-1">
                    Back-office administrateur
                </h1>

                <p class="text-muted mb-0">
                    Gestion des sweat-shirts Stubborn.
                </p>
            </div>

            <div class="mt-3 mt-md-0">
                <a
                    href="{{ path('app_admin_product_new') }}"
                    class="btn btn-success"
                >
                    Ajouter un sweat-shirt
                </a>
            </div>
        </div>

        {% if products is empty %}

            <div class="alert alert-info">
                Aucun produit disponible.
            </div>

        {% else %}

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Nom</th>
                            <th>Prix</th>
                            <th>Mis en avant</th>
                            <th>XS</th>
                            <th>S</th>
                            <th>M</th>
                            <th>L</th>
                            <th>XL</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for product in products %}
                            <tr>

                                <td class="fw-bold">
                                    {{ product.name }}
                                </td>

                                <td>
                                    {{ product.price|number_format(2, ',', ' ') }} €
                                </td>

                                <td>
                                    {% if product.featured %}
                                        <span class="badge bg-success">
                                            Oui
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">
                                            Non
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    {{ product.stockXs }}
                                </td>

                                <td>
                                    {{ product.stockS }}
                                </td>

                                <td>
                                    {{ product.stockM }}
                                </td>

                                <td>
                                    {{ product.stockL }}
                                </td>

                                <td>
                                    {{ product.stockXl }}
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">

                                        <a
                                            href="{{ path('app_admin_product_edit', { id: product.id }) }}"
                                            class="btn btn-warning btn-sm"
                                        >
                                            Modifier
                                        </a>

                                        <form
                                            method="post"
                                            action="{{ path('app_admin_product_delete', { id: product.id }) }}"
                                            onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete-product-' ~ product.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-danger btn-sm"
                                            >
                                                Supprimer
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        {% endfor %}
                    </tbody>

                </table>

            </div>

        {% endif %}

    </div>
{% endblock %}
