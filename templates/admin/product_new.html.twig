{% extends 'base.html.twig' %}

{% block title %}Ajouter un sweat-shirt - Stubborn{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <h1 class="h3 mb-4">
                            Ajouter un sweat-shirt
                        </h1>

                        {{ form_start(form) }}

                            <div class="mb-3">
                                {{ form_row(form.name) }}
                            </div>

                            <div class="mb-3">
                                {{ form_row(form.price) }}
                            </div>

                            <div class="mb-3">
                                {{ form_row(form.image) }}
                            </div>

                            <div class="mb-3">
                                {{ form_row(form.featured) }}
                            </div>

                            <hr>

                            <h2 class="h5 mb-3">
                                Stocks par taille
                            </h2>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    {{ form_row(form.stockXs) }}
                                </div>

                                <div class="col-md-4 mb-3">
                                    {{ form_row(form.stockS) }}
                                </div>

                                <div class="col-md-4 mb-3">
                                    {{ form_row(form.stockM) }}
                                </div>

                                <div class="col-md-6 mb-3">
                                    {{ form_row(form.stockL) }}
                                </div>

                                <div class="col-md-6 mb-3">
                                    {{ form_row(form.stockXl) }}
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <button
                                    type="submit"
                                    class="btn btn-success"
                                >
                                    Ajouter le produit
                                </button>

                                <a
                                    href="{{ path('app_admin') }}"
                                    class="btn btn-outline-secondary"
                                >
                                    Annuler
                                </a>
                            </div>

                        {{ form_end(form) }}

                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
