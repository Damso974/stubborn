{% extends 'base.html.twig' %}

{% block title %}Accueil - Stubborn{% endblock %}

{% block body %}
    <div class="container mt-4">

        <section class="text-center mb-5">
            <h1 class="display-4 fw-bold">
                Stubborn
            </h1>

            <p class="lead">
                Bienvenue sur la boutique Stubborn.
            </p>

            <p class="text-muted">
                Découvrez notre collection de sweat-shirts.
            </p>

            {% if app.user %}
                <a
                    href="{{ path('app_products') }}"
                    class="btn btn-primary mt-2"
                >
                    Voir toute la boutique
                </a>
            {% endif %}
        </section>

        <section>
            <div class="text-center mb-4">
                <h2>
                    Nos produits mis en avant
                </h2>
            </div>

            <div class="row g-4">

                {% for product in featuredProducts %}
                    <div class="col-12 col-sm-6 col-lg-4">

                        <div class="card h-100 shadow-sm border-0">

                            <img
                                src="{{ asset('images/products/' ~ product.image) }}"
                                class="card-img-top"
                                alt="{{ product.name }}"
                                style="
                                    height: 300px;
                                    object-fit: cover;
                                "
                            >

                            <div class="card-body d-flex flex-column">

                                <h3 class="card-title h4">
                                    {{ product.name }}
                                </h3>

                                <p class="card-text fs-5 fw-bold">
                                    {{ product.price|number_format(2, ',', ' ') }} €
                                </p>

                                {% if app.user %}
                                    <div class="mt-auto">
                                        <a
                                            href="{{ path('app_product_show', { id: product.id }) }}"
                                            class="btn btn-primary w-100"
                                        >
                                            Voir le produit
                                        </a>
                                    </div>
                                {% else %}
                                    <div class="mt-auto">
                                        <p class="text-muted mb-0">
                                            Connectez-vous pour consulter ce produit.
                                        </p>
                                    </div>
                                {% endif %}

                            </div>
                        </div>

                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">
                            Aucun produit mis en avant actuellement.
                        </div>
                    </div>
                {% endfor %}

            </div>
        </section>

    </div>
{% endblock %}
