{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Stubborn{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="row align-items-start">

            <div class="col-md-6 mb-4">
                <img
                    src="{{ asset('images/products/' ~ product.image) }}"
                    alt="{{ product.name }}"
                    class="img-fluid rounded shadow-sm w-100"
                    style="
                        max-height: 550px;
                        object-fit: cover;
                    "
                >
            </div>

            <div class="col-md-6">

                <h1 class="mb-3">
                    {{ product.name }}
                </h1>

                <p class="fs-3 fw-bold mb-4">
                    {{ product.price|number_format(2, ',', ' ') }} €
                </p>

                <form method="post">

                    <div class="mb-3">
                        <label
                            for="size"
                            class="form-label fw-bold"
                        >
                            Choisissez votre taille
                        </label>

                        <select
                            name="size"
                            id="size"
                            class="form-select"
                            required
                        >
                            <option value="">
                                Sélectionnez une taille
                            </option>

                            <option
                                value="XS"
                                {% if product.stockXs <= 0 %}disabled{% endif %}
                            >
                                XS
                                {% if product.stockXs > 0 %}
                                    - {{ product.stockXs }} disponible(s)
                                {% else %}
                                    - Rupture
                                {% endif %}
                            </option>

                            <option
                                value="S"
                                {% if product.stockS <= 0 %}disabled{% endif %}
                            >
                                S
                                {% if product.stockS > 0 %}
                                    - {{ product.stockS }} disponible(s)
                                {% else %}
                                    - Rupture
                                {% endif %}
                            </option>

                            <option
                                value="M"
                                {% if product.stockM <= 0 %}disabled{% endif %}
                            >
                                M
                                {% if product.stockM > 0 %}
                                    - {{ product.stockM }} disponible(s)
                                {% else %}
                                    - Rupture
                                {% endif %}
                            </option>

                            <option
                                value="L"
                                {% if product.stockL <= 0 %}disabled{% endif %}
                            >
                                L
                                {% if product.stockL > 0 %}
                                    - {{ product.stockL }} disponible(s)
                                {% else %}
                                    - Rupture
                                {% endif %}
                            </option>

                            <option
                                value="XL"
                                {% if product.stockXl <= 0 %}disabled{% endif %}
                            >
                                XL
                                {% if product.stockXl > 0 %}
                                    - {{ product.stockXl }} disponible(s)
                                {% else %}
                                    - Rupture
                                {% endif %}
                            </option>
                        </select>
                    </div>

                    <button
                        type="submit"
                        class="btn btn-primary w-100 mb-3"
                    >
                        Ajouter au panier
                    </button>

                </form>

                <a
                    href="{{ path('app_products') }}"
                    class="btn btn-outline-secondary w-100"
                >
                    Retour à la boutique
                </a>

            </div>

        </div>

    </div>
{% endblock %}
