{% extends 'base.html.twig' %}

{% block title %}Boutique{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <h1 class="mb-3 mb-md-0">
                Boutique
            </h1>

            <div class="d-flex flex-wrap gap-2">
                <a
                    href="{{ path('app_products') }}"
                    class="btn {{ priceRange is empty ? 'btn-primary' : 'btn-outline-primary' }}"
                >
                    Tous
                </a>

                <a
                    href="{{ path('app_products', { price: '10-29' }) }}"
                    class="btn {{ priceRange == '10-29' ? 'btn-primary' : 'btn-outline-primary' }}"
                >
                    10 € - 29 €
                </a>

                <a
                    href="{{ path('app_products', { price: '29-35' }) }}"
                    class="btn {{ priceRange == '29-35' ? 'btn-primary' : 'btn-outline-primary' }}"
                >
                    29 € - 35 €
                </a>

                <a
                    href="{{ path('app_products', { price: '35-50' }) }}"
                    class="btn {{ priceRange == '35-50' ? 'btn-primary' : 'btn-outline-primary' }}"
                >
                    35 € - 50 €
                </a>
            </div>
        </div>

        <div class="row g-4">
            {% for product in products %}
                <div class="col-12 col-sm-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <img
                            src="{{ asset('images/products/' ~ product.image) }}"
                            class="card-img-top"
                            alt="{{ product.name }}"
                            style="
                                height: 300px;
                                object-fit: cover;
                            "
                        >

                        <div class="card-body d-flex flex-column">

                            <h2 class="card-title h4">
                                {{ product.name }}
                            </h2>

                            <p class="card-text fs-5 fw-bold">
                                {{ product.price|number_format(2, ',', ' ') }} €
                            </p>

                            <div class="mt-auto">
                                <a
                                    href="{{ path('app_product_show', { id: product.id }) }}"
                                    class="btn btn-primary w-100"
                                >
                                    Voir le produit
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        Aucun produit disponible dans cette tranche de prix.
                    </div>
                </div>
            {% endfor %}
        </div>

    </div>
{% endblock %}
