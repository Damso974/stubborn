{% extends 'base.html.twig' %}

{% block title %}Panier - Stubborn{% endblock %}

{% block body %}
    <div class="container mt-4">

        <h1 class="mb-4">
            Mon panier
        </h1>

        {% if items is empty %}

            <div class="alert alert-info">
                Votre panier est vide.
            </div>

            <a
                href="{{ path('app_products') }}"
                class="btn btn-primary"
            >
                Voir la boutique
            </a>

        {% else %}

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Produit</th>
                            <th>Taille</th>
                            <th>Quantité</th>
                            <th>Prix</th>
                            <th>Sous-total</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for item in items %}

                            <tr>

                                <td class="fw-bold">
                                    {{ item.product.name }}
                                </td>

                                <td>
                                    {{ item.size }}
                                </td>

                                <td>
                                    {{ item.quantity }}
                                </td>

                                <td>
                                    {{ item.product.price|number_format(2, ',', ' ') }} €
                                </td>

                                <td class="fw-bold">
                                    {{ item.subtotal|number_format(2, ',', ' ') }} €
                                </td>

                                <td>
                                    <a
                                        href="{{ path('app_cart_remove', { key: item.key }) }}"
                                        class="btn btn-outline-danger btn-sm"
                                    >
                                        Retirer
                                    </a>
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

            <div class="row mt-4">

                <div class="col-md-6 mb-3">
                    <a
                        href="{{ path('app_products') }}"
                        class="btn btn-outline-secondary"
                    >
                        Continuer mes achats
                    </a>
                </div>

                <div class="col-md-6 text-md-end">

                    <h2 class="h4 mb-3">
                        Total :
                        <strong>
                            {{ total|number_format(2, ',', ' ') }} €
                        </strong>
                    </h2>

                    <form
                        method="post"
                        action="{{ path('app_cart_checkout') }}"
                        data-turbo="false"
                    >
                        <button
                            type="submit"
                            class="btn btn-success btn-lg"
                        >
                            Finaliser ma commande
                        </button>
                    </form>

                </div>

            </div>

        {% endif %}

    </div>
{% endblock %}
